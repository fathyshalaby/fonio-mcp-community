# Workspace API key from app.fonio.ai/api-keys (local stdio). Hosted Claude/ChatGPT
# use community MCP OAuth: official login stays on app.fonio.ai, then paste this key.
# Never put your fonio password here.
FONIO_API_KEY=

# HMAC secret for OAuth codes, workspace cookies, and encrypted access tokens.
# Required in production so sessions survive deploys. openssl rand -hex 32
FONIO_MCP_SECRET=

# Public origin for install snippets and OAuth metadata (e.g. https://your-app.vercel.app)
# Leave unset to infer from the Host / X-Forwarded-* headers.
# NEXT_PUBLIC_MCP_ORIGIN=https://your-host

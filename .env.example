# Workspace API key from app.fonio.ai (local stdio only; hosted clients use MCP OAuth).
FONIO_API_KEY=

# HMAC secret for OAuth codes, workspace cookies, and encrypted access tokens.
# Required in production so sessions survive deploys. openssl rand -hex 32
FONIO_MCP_SECRET=

# Public origin for install snippets and OAuth metadata (e.g. https://fonio-mcp.vercel.app)
# Leave unset to infer from the Host / X-Forwarded-* headers.
# NEXT_PUBLIC_MCP_ORIGIN=https://your-host

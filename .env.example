# Workspace API key from app.fonio.ai (stdio / server-side fallback).
FONIO_API_KEY=

# HMAC secret for OAuth codes and encrypted access tokens (required in production).
FONIO_MCP_SECRET=

# Public origin for install snippets and OAuth metadata (e.g. https://fonio-mcp.vercel.app)
# NEXT_PUBLIC_MCP_ORIGIN=https://your-host

# Optional override (default https://app.fonio.ai/api)
# FONIO_BASE_URL=https://app.fonio.ai/api
